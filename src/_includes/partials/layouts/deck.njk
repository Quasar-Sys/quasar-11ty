<section id="deck" class="main">
    <header>
      <h2>
        <span class="shrink">{{ deck.text.title }}</span>
      </h2>
      <p>{{ deck.text.copy }}</p>
    </header>
    <div class="deck inner">
        {% for card in deck.features %}
        <article 
          style="--card-image: url('{{ site.path.siteRoot }}{{ site.path.imageDir }}card1-bg.webp');">
            <img src="{{ site.path.siteRoot }}{{ site.path.imageDir }}{{ card.icon }}">
            <h3>{{ card.heading }}</h3>
            <p>{{ card.caption }}</p>
        </article>
        {% endfor %}
    </div>
</section>