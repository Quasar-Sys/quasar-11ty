<section id="banner">
  <div class="content primary inner">
    <header>
      <h1>
        <span class="shrink">{{ banner.text.headline }}</span>
      </h1>
      <p>{{ banner.text.subHeadline }}</p>
    </header>
  </div>

  {% if banner.features %}
  <div class="content secondary inner">
      {% for row in banner.features %}
      <div class="features">
        {% for section in row %}
        <section>
          <div class="icon major">
            <i class="{{ section.icon }}"></i>
          </div>
          <h3>
            {{ section.heading }}
          </h3>
          <p>{{ section.caption }}</p>
        </section>
        {% endfor %}
      </div>
      {% endfor %}
  </div>
  {% endif %}

  <div class="content secondary inner">
    <div class="risk-reversal-cta">
      <div class="cta">
        <ul class="actions special">
          <li>
            <a href="{{ banner.text.ctaLink }}" class="button large wide scrolly">
              {{ banner.text.ctaText }}
            </a>
          </li>
        </ul>
      </div>
      <div  class="risk-reversal">
        <p>{{ banner.text.ctaMicroCopy | safe }}</p>
      </div>
    </div>
  </div>

  {% if banner.video %}
  <video class="background" autoplay muted loop>
    <source src="{{ site.path.siteRoot }}{{ site.path.imageDir }}{{ banner.video.src }}" type="{{ banner.video.type }}">
  </video>
  {% endif %}

  {% if banner.picture %}
  <picture class="background">
    <source media="(orientation: portrait)"
      srcset="{{ site.path.siteRoot }}{{ site.path.imageDir }}{{ banner.picture.srcTall }}">

    <img src="{{ site.path.siteRoot }}{{ site.path.imageDir }}{{ banner.picture.srcWide }}"
      alt="{{ banner.picture.altText }}">
  </picture>
  {% endif %}

</section>